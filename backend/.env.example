# 复制成 .env 后按需修改（所有变量都以 QUIZ_ 开头）

# 环境：dev / prod
QUIZ_ENV=dev
QUIZ_DEBUG=false

# 数据库：默认 SQLite 单文件；生产可换 PostgreSQL
# QUIZ_DATABASE_URL=postgresql+psycopg://quiz:password@db:5432/quiz
QUIZ_DATABASE_URL=sqlite:///./app/data/app.db

# 认证：生产必须设置成随机长字符串（openssl rand -hex 32）
QUIZ_JWT_SECRET=dev-secret-change-me-please
QUIZ_TOKEN_TTL_MINUTES=10080

# 判题
QUIZ_JUDGE_TIMEOUT=6
QUIZ_JUDGE_MEMORY_MB=256
QUIZ_JUDGE_WORKERS=2

# 单步执行（把代码逐行走一遍并录像）
QUIZ_TRACE_TIMEOUT=5
QUIZ_TRACE_MAX_STEPS=800

# 注册邀请码：留空 = 任何人可注册；对外公开建议填一个只有同学知道的码
QUIZ_REGISTER_CODE=

# ICP 备案号：备案通过后填（如 蜀ICP备2026000001号-1）
# 服务端会把它渲染到页面左下角并链接到工信部——法律要求，不能省
QUIZ_BEIAN=

# 网页版静态目录（默认按仓库结构推断；Docker 镜像里是 /app/web）
# QUIZ_WEB_DIR=/app/web

# 限流（每 IP 每分钟）
QUIZ_RATE_LIMIT_PER_MINUTE=120
QUIZ_RATE_LIMIT_AUTH_PER_MINUTE=10

# 跨域：前端单独部署时填它的地址，逗号分隔
QUIZ_CORS_ORIGINS=

# 启动时灌题库
QUIZ_SEED_ON_START=true
