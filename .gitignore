# 打包中间产物（dist/Python刷题系统/ 目录版会入库，方便 clone 后直接运行）
build/
*.spec
pylibs/
dist/*.zip

# Python 缓存（注意：不要用 *.py[cod]，那会连打包出来的 .pyd 扩展模块一起忽略）
__pycache__/
*.pyc
*.pyo
.venv/

# 运行期临时文件
tmp_run/
.diag/
*.log

# 系统文件
Thumbs.db
desktop.ini
.DS_Store

# 本地状态（学习进度，不入库）
state.json
data/
*.json.bak

# 例外：后端要用的题库种子文件（data/ 上面那条会把所有 data 目录都忽略掉）
!backend/app/data/
backend/app/data/*
!backend/app/data/questions.json

# 前端（React + Vite）：依赖与构建产物都不入库，部署时现构建
frontend/node_modules/
frontend/dist/
frontend/.tmp/
frontend/.vite/
frontend/*.tsbuildinfo

# Office 临时锁文件
~$*

# 比赛提交包（_pack_submission.py 产出，体积大，不入库）
docs/submission/

# 文档渲染检查的中间产物
docs/_preview/
docs/_check_*.json
